# systemd-networkd config for the Nessum adapter.
# Install to /etc/systemd/network/ and run: systemctl restart systemd-networkd
[Match]
Name=eth2

[Link]
# Carrier follows the Nessum link state (the adapter sends NCM link notifications),
# so don't block boot waiting for a peer.
RequiredForOnline=no

[Network]
DHCP=yes
# Or static, e.g.:
# Address=192.168.50.2/24
