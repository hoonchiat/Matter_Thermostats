# Kernel config fragment for the USB <-> Nessum adapter on the Linux host.
# Merge with: scripts/kconfig/merge_config.sh .config kernel.config
# Architecture-independent (arm64 / armhf / x86 alike).

CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDC_NCM=m
# Management console (/dev/ttyACM*)
CONFIG_USB_ACM=m

# The USB host controller is SoC-specific on Cortex-A53 parts. Enable the one yours uses:
#   i.MX 8M / RK3328 / many others: CONFIG_USB_DWC3=y + CONFIG_USB_XHCI_HCD=y
#   Allwinner H5/H6, older SoCs:     CONFIG_USB_EHCI_HCD=y (+ platform glue)
#   BCM2837 (Raspberry Pi 3):        CONFIG_USB_DWCOTG / CONFIG_USB_DWC2=y
