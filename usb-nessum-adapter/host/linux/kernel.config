# Kernel config fragment for the USB <-> Nessum adapter on a TI Cortex-A53 host
# (Sitara AM62x / AM62A / AM62P / AM64x / AM65x, TI Processor SDK Linux).
# Merge with: scripts/kconfig/merge_config.sh .config kernel.config
# Check a running board with: zcat /proc/config.gz | grep -E 'CDC_NCM|USB_ACM|DWC3|CDNS3'

# --- Adapter class drivers (all SoCs) ---
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDC_NCM=m
# Management console (/dev/ttyACM*) used by nessumctl
CONFIG_USB_ACM=m

# --- USB host controller: enable the block for your SoC ---
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y

# AM62x / AM62A / AM62P: Synopsys DWC3 with TI AM62 glue
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_AM62=y

# AM64x: Cadence USB3 controller with TI glue
# CONFIG_USB_CDNS_SUPPORT=y
# CONFIG_USB_CDNS3=y
# CONFIG_USB_CDNS3_HOST=y
# CONFIG_USB_CDNS3_TI=y

# AM65x: Synopsys DWC3 with Keystone/AM654 glue
# CONFIG_USB_DWC3=y
# CONFIG_USB_DWC3_KEYSTONE=y

# Device tree: the USB port must be in host (or OTG) mode, e.g. dr_mode = "host"
# on the &usb0/&usb1 DWC3 node (AM62x), or on the cdns3 node (AM64x).
