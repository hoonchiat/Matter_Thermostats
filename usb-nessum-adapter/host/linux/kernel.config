# Kernel config fragment for the USB <-> Nessum adapter on a TI AM62x host
# (TI Processor SDK Linux). The SDK's defconfig usually has most of these already.
# Merge with: scripts/kconfig/merge_config.sh .config kernel.config
# Check a running board with: zcat /proc/config.gz | grep -E 'CDC_NCM|USB_ACM|DWC3'

# --- Adapter class drivers ---
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDC_NCM=m
# Management console (/dev/ttyACM*), used by nessumctl and factory_program.py
CONFIG_USB_ACM=m

# --- AM62x USB host controller: Synopsys DWC3 with TI AM62 glue (xHCI host) ---
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_AM62=y

# Device tree: the AM62x USB port the adapter plugs into must be in host (or OTG)
# mode, e.g. in the board .dts:
#   &usb1 { dr_mode = "host"; };
