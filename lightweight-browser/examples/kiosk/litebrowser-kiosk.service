# Boots straight into LiteBrowser, fullscreen, on a Wayland kiosk compositor.
#
#   sudo apt install cage
#   sudo cp litebrowser-kiosk.service /etc/systemd/system/
#   sudo systemctl edit litebrowser-kiosk   # set User= and the URL
#   sudo systemctl enable --now litebrowser-kiosk
#
# cage runs one app fullscreen and turns touch input into Wayland touch events.

[Unit]
Description=LiteBrowser touch-screen kiosk
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=wayland
# Add --no-gpu if the board's GPU driver renders pages incorrectly.
ExecStart=/usr/bin/cage -- /usr/local/bin/litebrowser --kiosk http://localhost:3000
# Portrait (1080x1920) with a landscape panel mounted on its side: rotate the
# output inside cage first (apt install wlr-randr; find the output name with
# `wlr-randr`; use 270 to turn the other way), and use this line instead:
# ExecStart=/usr/bin/cage -- sh -c 'wlr-randr --output HDMI-A-1 --transform 90; exec /usr/local/bin/litebrowser --kiosk http://localhost:3000'
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
